# Backend Environment Variables
# Copy this file to .env and update the values accordingly

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# MongoDB connection URI
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
# For local development: mongodb://localhost:27017/servicehive
MONGO_URI=mongodb://localhost:27017/servicehive

# JWT Configuration
# Use a strong, random string for production
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# CORS Configuration
# Frontend URL for CORS policy
CLIENT_URL=http://localhost:5173
